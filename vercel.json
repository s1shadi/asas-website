{
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/shadi/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/shadi",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!\\.well-known).*)",
      "has": [
        {
          "type": "host",
          "value": "www.asas-mind.com"
        }
      ],
      "destination": "https://asas-mind.com/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.asas-mind.com"
        }
      ],
      "destination": "https://asas-mind.com/",
      "permanent": true
    },
    {
      "source": "/impressum.html",
      "destination": "/impressum",
      "permanent": true
    },
    {
      "source": "/datenschutz.html",
      "destination": "/datenschutz",
      "permanent": true
    },
    {
      "source": "/agb.html",
      "destination": "/agb",
      "permanent": true
    },
    {
      "source": "/widerruf.html",
      "destination": "/widerruf",
      "permanent": true
    }
  ]
}
