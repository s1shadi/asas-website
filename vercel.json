{
  "headers": [
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        }
      ]
    },
    {
      "source": "/shadi/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/shadi",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/shadi/index.html",
      "destination": "/shadi/",
      "permanent": true
    },
    {
      "source": "/((?!\\.well-known).*)",
      "has": [
        {
          "type": "host",
          "value": "www.asas-mind.com"
        }
      ],
      "destination": "https://asas-mind.com/$1",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.asas-mind.com"
        }
      ],
      "destination": "https://asas-mind.com/",
      "permanent": true
    },
    {
      "source": "/impressum.html",
      "destination": "/impressum",
      "permanent": true
    },
    {
      "source": "/datenschutz.html",
      "destination": "/datenschutz",
      "permanent": true
    },
    {
      "source": "/agb.html",
      "destination": "/agb",
      "permanent": true
    },
    {
      "source": "/widerruf.html",
      "destination": "/widerruf",
      "permanent": true
    },
    {
      "source": "/demo-website",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/demo-website/ueber-asas",
      "destination": "/ueber-asas",
      "permanent": true
    },
    {
      "source": "/demo-website/affiliate",
      "destination": "/affiliate",
      "permanent": true
    },
    {
      "source": "/demo-website/impressum",
      "destination": "/impressum",
      "permanent": true
    },
    {
      "source": "/demo-website/datenschutz",
      "destination": "/datenschutz",
      "permanent": true
    },
    {
      "source": "/demo-website/agb",
      "destination": "/agb",
      "permanent": true
    },
    {
      "source": "/demo-website/widerruf",
      "destination": "/widerruf",
      "permanent": true
    }
  ]
}
